# Turso / libSQL (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Token for /admin/routes write operations (Bearer)
ADMIN_TOKEN=
# Inbox for user feedback reports
ADMIN_EMAIL=
# Resend API key (https://resend.com) — required to deliver feedback emails
RESEND_API_KEY=
# Optional verified sender, e.g. Escape From Gorditos <noreply@yourdomain.com>
# FEEDBACK_FROM_EMAIL=
CRON_SECRET=
# Site gate passwords (login screen). Either permanent token unlocks the app.
# A 4-digit weekly code (rotates Monday 05:00 Europe/Madrid) also unlocks the app.
# Only PUBLIC sessions can reveal this week's code from the home screen.
# Server-side only — do not prefix with VITE_.
PERMANENT_TOKEN_PUBLIC=
PERMANENT_TOKEN_PRIVATE=
