# Turso / libSQL (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Token for /admin/routes write operations (Bearer)
ADMIN_TOKEN=
# Inbox for user feedback reports
ADMIN_EMAIL=
# Resend API key (https://resend.com) — required to deliver feedback emails
RESEND_API_KEY=
# Optional verified sender, e.g. Escape From Gorditos <noreply@yourdomain.com>
# FEEDBACK_FROM_EMAIL=
CRON_SECRET=
# Site gate passwords (login screen). Each permanent token unlocks the app.
# PUBLIC and MV each derive a distinct 4-digit weekly code (Monday 05:00 Europe/Madrid).
# Permanent PUBLIC / MV sessions can reveal their own weekly code from the home screen.
# Weekly / PRIVATE / admin sessions cannot reveal a code.
# PUBLIC (token or weekly) uses Gorditos logos; MV (token or weekly) uses the default logos.
# Server-side only — do not prefix with VITE_.
PERMANENT_TOKEN_PUBLIC=
PERMANENT_TOKEN_MV=
PERMANENT_TOKEN_PRIVATE=
